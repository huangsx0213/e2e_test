# --- QuantumQA Agent Configuration ---

# 1. Server URL (WebSocket)
# In production, change this to your remote server's IP/Domain
# Example: ws://1.2.3.4:3000
SERVER_URL=ws://localhost:3000

# 2. Agent Identifier (Optional)
# If left empty, a random ID will be generated (e.g., agent-abc123)
# AGENT_ID=my-custom-node-01
